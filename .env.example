# Metina Pro — no private key is stored there.
METINA_URL=https://pro.metina.id
METINA_EMAIL=
METINA_PASSWORD=

# Stays on THIS machine only. Never commit this file.
EVM_PRIVATE_KEY=0x

# Required — copy the same RPC URLs from Settings (browser only, not on the server).
# Fill every chain you have positions on.
RPC_ROBINHOOD=
RPC_BASE=
RPC_BSC=
# RPC_ETHEREUM=

# How often to refresh open positions (ms). Desk tab uses 45000.
POLL_MS=45000

# Full NFT rediscover every N polls (~6 min at 45s).
DISCOVER_EVERY=8

# 0 = log what would close, do not send close. Telegram /close is also ignored.
# 1 = actually close + swap when SL/TP hits, or when you send /close.
LIVE_CLOSE=0

# 0 = Telegram /open looks up the pool but does not mint (needs TELEGRAM_* below).
# 1 = actually mint via Metina Pro (same as the desk Open button).
# Example: /open 0xToken 0.5 robinhood quote=usdg side=single sl=-50 tp=20
LIVE_OPEN=0

# Telegram (optional — kosong = notifikasi off)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=          # chat / group / channel ID
TELEGRAM_MESSAGE_THREAD_ID= # optional: forum topic / channel thread
TELEGRAM_ENABLED=1         # 0 = matikan tanpa hapus token

# Anti-spam for Telegram commands (stops a chat from flooding Pro lookup/deploy).
# TELEGRAM_CMD_INTERVAL_MS=2000
# TELEGRAM_OPEN_COOLDOWN_MS=45000
# TELEGRAM_CLOSE_COOLDOWN_MS=10000

